
`timescale 1ns / 1ps

module tb_pipeline_reg;

    localparam DATA_WIDTH = 32;

    logic clk, rst;
    logic [DATA_WIDTH-1:0] in_data;
    logic in_valid, in_ready;
    logic [DATA_WIDTH-1:0] out_data;
    logic out_valid, out_ready;

    pipeline_reg #(.DATA_WIDTH(DATA_WIDTH)) dut (
        .clk(clk),
        .rst(rst),
        .in_data(in_data),
        .in_valid(in_valid),
        .in_ready(in_ready),
        .out_data(out_data),
        .out_valid(out_valid),
        .out_ready(out_ready)
    );

    // Clock generation: 10 ns period
    always #5 clk = ~clk;

    initial begin
        clk       = 1'b0;
        rst       = 1'b1;
        in_data   = '0;
        in_valid  = 1'b0;
        out_ready = 1'b0;

        // Reset for 2 cycles, then release cleanly on a negedge
        repeat (2) @(posedge clk);
        @(negedge clk);
        rst = 1'b0;

        // -------------------------
        // 1) Normal transfer
        // -------------------------
        @(negedge clk);
        in_data   = 32'h0000_0055;
        in_valid  = 1'b1;
        out_ready = 1'b1;

        @(negedge clk);
        in_valid  = 1'b0;

        // -------------------------
        // 2) Backpressure / stall
        // -------------------------
        @(negedge clk);
        in_data   = 32'h0000_AA11;
        in_valid  = 1'b1;
        out_ready = 1'b0;

        // Keep stall visible for multiple cycles
        repeat (3) @(negedge clk);

        in_data   = 32'h0000_BB22;
        in_valid  = 1'b1;
        out_ready = 1'b0;

        repeat (2) @(negedge clk);

        // -------------------------
        // 3) Recovery
        // -------------------------
        out_ready = 1'b1;

        @(negedge clk);
        in_valid  = 1'b0;
        out_ready = 1'b1;

        repeat (4) @(posedge clk);
        $finish;
    end

    initial begin
        $monitor("T=%0t rst=%0b in_v=%0b in_r=%0b in_d=%h | out_v=%0b out_r=%0b out_d=%h",
                 $time, rst, in_valid, in_ready, in_data, out_valid, out_ready, out_data);
    end

endmodule
